{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "packageName": "world.neel.aimanager",
  "developer": {
    "name": "AI Manager",
    "websiteUrl": "https://status.neel.world",
    "privacyUrl": "https://status.neel.world/privacy",
    "termsOfUseUrl": "https://status.neel.world/terms"
  },
  "name": {
    "short": "AI Manager",
    "full": "AI Manager — status digests"
  },
  "description": {
    "short": "Evidence-backed status digests. Approve before anyone sees them.",
    "full": "AI Manager delivers veto-first status digests into Teams. Same loop as Slack: Approve · Edit · Don't send. Chat is delivery only — GitHub is the work source. No private 1:1 wiretap."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#111111",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal", "team"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "status",
              "description": "Open latest status digest actions"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["status.neel.world"],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://status.neel.world/bot"
  }
}
