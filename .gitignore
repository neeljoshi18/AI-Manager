# Build artifacts
**/target/
**/dist/
**/build/

# Secrets & local env
.env
**/.env
**/.env.local
!**/.env.example
**/secrets/dev_secrets.json
**/secrets/*.local.json
**/secrets/staging*.json
deploy/.env.staging
deploy/secrets/

# Never commit SSH private keys or local key dumps
ssh/
**/*.pem
**/id_ed25519
**/id_rsa

# OS / IDE
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs & temp
*.log
/tmp/
**/tmp/

# Docker volumes (if ever bind-mounted into repo)
**/data/
**/cockroach-data/
**/clickhouse-data/
**/minio-data/

# Coverage / profiling
*.profraw
lcov.info
coverage/

# Python (if any scripts later)
**/__pycache__/
*.pyc
.venv/
