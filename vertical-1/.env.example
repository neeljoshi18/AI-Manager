# Vertical 1 runtime configuration
RUNTIME_MODE=embedded
# RUNTIME_MODE=production

HTTP_BIND=0.0.0.0:18080
QUERY_BIND=0.0.0.0:18081
CONSUMER_GROUP=v1-clickhouse-writer

RATE_LIMIT_PER_MINUTE=10000
DEDUP_TTL_SECS=86400

# Set true only for local synthetic tests (never in staging/prod)
SKIP_AUTH=false

# Production backends (used when RUNTIME_MODE=production + --features production)
REDIS_URL=redis://127.0.0.1:6379
KAFKA_BROKERS=localhost:19092
COCKROACH_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=enterprise_telemetry
# Local docker-compose credentials (see docker-compose.yml)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=vertical1

S3_ENDPOINT=http://localhost:9002
S3_BUCKET=ai-manager-telemetry
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

RUST_LOG=info,telemetry_core=debug,telemetry_ingestion=info
